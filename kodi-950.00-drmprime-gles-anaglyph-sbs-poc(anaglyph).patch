+  /*
+   * Rockchip DRMPRIME/GLES proof-of-concept:
+   * treat every external video texture as half-SBS and mix it to red/cyan
+   * anaglyph. This is intentionally hardcoded for the first hardware test.
+   */
+  vec2 uv = m_cord0.xy;
+  vec4 leftEye = texture2D(m_samp0, vec2(uv.x * 0.5, uv.y));
